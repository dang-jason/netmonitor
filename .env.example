# PostgreSQL connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=netmonitor
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password

# Network discovery settings
DISCOVERY_NETWORK=192.168.1.0/24
DEVICE_LOCATION=home

# Ping monitoring settings
MONITOR_INTERVAL_SECONDS=30
MONITOR_CONCURRENCY=50
MONITOR_RETRIES=1
MONITOR_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO

# API settings
API_HOST=127.0.0.1
API_PORT=3000
API_TOKEN=replace-with-a-random-secret-at-least-32-characters-long

# Optional SNMPv2c settings; leave the community blank if you do not use SNMP.
SNMP_COMMUNITY=
SNMP_PORT=161
SNMP_TIMEOUT_SECONDS=2
SNMP_RETRIES=1
SNMP_CONCURRENCY=20
SNMP_INTERVAL_SECONDS=60
